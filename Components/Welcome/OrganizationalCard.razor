@namespace Univents.Components.Welcome
@using Univents.Models

<div class="flex items-center gap-4 p-4 rounded-2xl transition-transform hover:-translate-y-0.5 cursor-pointer" style="background:#ffffff; box-shadow:0 1px 4px rgba(0,0,0,0.06);">
    <div class="w-12 h-12 rounded-xl flex items-center justify-center text-sm font-black flex-shrink-0" style="background:@(Org.Color); color:#1a1a1a; font-family:'Outfit', sans-serif;">
        @Org.Initial
    </div>

    <div class="flex-1 min-w-0">
        <p class="font-bold text-sm truncate" style="font-family:'Outfit', sans-serif; color:#1a1a1a;">
            @Org.Name
        </p>
        <p class="text-xs mt-0.5" style="color:#888;">
            @Org.Members.ToString("N0") members &middot; @Org.Events events
        </p>
        <span class="inline-block mt-1.5 text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:@(Org.Color)33; color:#1a1a1a;">
            @Org.Tag
        </span>
    </div>

    <button @onclick="HandleToggleJoin"
            class="flex-shrink-0 px-3 py-1.5 rounded-lg text-xs font-bold transition-all"
            style="background:@(IsJoined ? "#1a1a1a" : "#c5e61c"); color:@(IsJoined ? "#c5e61c" : "#1a1a1a"); font-family:'Outfit', sans-serif;">
        @(IsJoined ? "Joined" : "Join")
    </button>
</div>

@code {
    [Parameter, EditorRequired] public OrganizationItem Org { get; set; } = null!;
    [Parameter] public bool IsJoined { get; set; }
    [Parameter] public EventCallback<int> OnToggleJoin { get; set; }

    private Task HandleToggleJoin() => OnToggleJoin.InvokeAsync(Org.Id);
}
